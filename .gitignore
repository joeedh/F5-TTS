# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# plan 00 spike: generated ONNX models and tensors (tools/webgpu/spike_export.py)
web/spikes/ort-block/public/data/
# the result JSON is committed (the generic results/ rule above would hide it); the verbose logs are not
!web/spikes/ort-block/results/
web/spikes/ort-block/results/*.log

# plan 00 golden data: only the tiny case is committed; the rest is rebuilt by tools/webgpu/make_golden.py
testdata/webgpu/*
!testdata/webgpu/tiny/
# plan 02: audio fixtures from tools/webgpu/export_audio_fixtures.py
!testdata/webgpu/audio-fixtures/
# plan 03: the edge cases and their dump are committed; a downloaded corpus goes in corpus/ and is not
!testdata/webgpu/text/
testdata/webgpu/text/corpus/
# plan 04: synthetic chunk-plan fixtures from upstream's code (tools/webgpu/plan_fixtures.py)
!testdata/webgpu/pipeline/
web/test-results/
web/playwright-report/
!testdata/webgpu/tolerances.json
!testdata/webgpu/floors.json
# CUDA outputs saved by measure_floor.py --dump, for the parity smoke test
testdata/webgpu/*/cuda/
# plan 01: only the unfused tiny graphs are committed; export_dit.py --attention mha|onnx23 rebuilds the rest
testdata/webgpu/tiny/onnx/*_mha*
testdata/webgpu/tiny/onnx/*_onnx23*
