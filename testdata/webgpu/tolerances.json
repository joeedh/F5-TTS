{
  "method": "10x the worst CPU fp32 vs CUDA fp32 (TF32 off) difference over all real cases, rounded up to a power of ten; see docs/plans/webgpu-00-scope-and-parity.md, Tolerances",
  "measured_with": {
    "torch": "2.15.0+cu132",
    "gpu": "NVIDIA GeForce RTX 5050 Laptop GPU",
    "cases": [
      "en-epss16",
      "en-multi",
      "en-multi-fixdur",
      "en-prep",
      "en-short",
      "zh-short"
    ]
  },
  "exact": [
    "text.max_chars",
    "text.chunks",
    "text.tokens",
    "dit.text_ids",
    "plan.duration",
    "plan.ref_audio_len",
    "plan.local_speed"
  ],
  "near_zero_rule": "relative L2 is not used where ||golden|| < 1e-6 * size; max_abs decides",
  "checks": {
    "plan.t": {
      "note": "time grid after sway",
      "max_abs": 1e-06,
      "floor_max_abs": 5.960464477539063e-08,
      "floor_max_abs_at": "en-epss16/c0.plan.t"
    },
    "audio.resample": {
      "note": "informational; plan 02 decides (a different resampler may be accepted)",
