{
  "name": "f5-tts-web",
  "private": true,
  "description": "F5-TTS inference in the browser on WebGPU. See docs/plans/webgpu-port-tasks.md.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser-local": "playwright test -c playwright.local.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@webgpu/types": "^0.1.74",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "protobufjs": false
  }
}
